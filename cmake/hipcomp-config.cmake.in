#[=======================================================================[

hipCOMP is a HIP library that features generic compression interfaces to enable
developers to use high-performance GPU compressors and decompressors in their applications.

Result Variables
^^^^^^^^^^^^^^^^

This module will construct the following targets::
  hipcomp::hipcomp

This module will set the following variables::

  HIPCOMP_FOUND

#]=======================================================================]

@PACKAGE_INIT@

find_package(HIPToolkit REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/hipcomp-targets.cmake")

check_required_components(hipcomp)

set(${CMAKE_FIND_PACKAGE_NAME}_CONFIG "${CMAKE_CURRENT_LIST_FILE}")

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(${CMAKE_FIND_PACKAGE_NAME} CONFIG_MODE)