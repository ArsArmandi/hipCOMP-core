{
  "name": "hipCOMP ROCm Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash .devcontainer/build.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "eamodio.gitlens"
      ],
      "settings": {
        "cmake.configureOnOpen": false
      }
    }
  }
}
